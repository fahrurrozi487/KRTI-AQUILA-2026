<?xml version="1.0"?>
<model>
  <name>gate_leg</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    1 lapis gate Double/Triple bentuk-U (2 kaki + palang atas, TANPA palang
    bawah -- gate_multi_detector.py). Dipakai berulang (2x utk double, 3x utk
    triple) di world file dgn pose beda per layer. Warna oranye HSV mid
    tuning gate_multi_detector.py (5,80,40)-(25,255,255).
  </description>
</model>
