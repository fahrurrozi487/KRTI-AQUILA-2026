<?xml version="1.0"?>
<model>
  <name>gate_single</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    Single Gate: dinding oranye solid dgn 1 lubang persegi (gate_detector.py
    lama, gate_node.py) -- topologi BEDA dari gate_leg (gate_multi_detector.py):
    di sini TERTUTUP di 4 sisi (kolom kiri/kanan + palang atas/bawah), bukan
    bentuk-U terbuka bawah. Warna oranye HSV mid gate_detector.py (8,80,80)-
    (30,255,255).
  </description>
</model>
