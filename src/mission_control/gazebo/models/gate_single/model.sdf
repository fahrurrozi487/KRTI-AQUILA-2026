<?xml version='1.0'?>
<sdf version="1.6">
  <model name="gate_single">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <!-- 2026-09-04 FIX: HAPUS slab bawah; gate_detector.py::_make_synthetic()
           (self-test resmi node ini) membuktikan Single Gate ASLI terbuka di
           bawah ("lubangi celah dari bawah balok atas ke dasar"), BUKAN dinding
           tertutup 4 sisi. Kolom-profil detect() cuma scan band 35%-100% tinggi
           bbox; slab bawah (versi lama) bikin band itu selalu ada oranye penuh,
           num_openings selalu 0. Sekarang: kaki kiri/kanan + balok atas SAJA,
           persis topologi gate_leg (meski algoritma deteksinya beda). -->
      <visual name="top"><pose>0 0 3.15 0 0 0</pose>
        <geometry><box><size>3.0 0.1 0.3</size></box></geometry>
        <material><ambient>0.655 0.499 0.226 1</ambient><diffuse>0.655 0.499 0.226 1</diffuse><emissive>0.655 0.499 0.226 1</emissive></material>
      </visual>
      <collision name="top_col"><pose>0 0 3.15 0 0 0</pose>
        <geometry><box><size>3.0 0.1 0.3</size></box></geometry></collision>
