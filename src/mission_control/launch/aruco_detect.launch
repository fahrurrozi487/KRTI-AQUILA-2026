<launch>
    <!-- FASE C: detektor ArUco 7x7 kamera bawah -->
    <arg name="image_topic"      default="/camera_down/image_raw" />
    <arg name="dictionary"       default="DICT_7X7_50" />
    <arg name="valid_ids"        default="1,2,3,4" />
    <arg name="invert"           default="true" />         <!-- true: putih-di-hitam (terpal) -->
    <arg name="marker_length"    default="0.0" />
    <arg name="camera_info_topic" default="" />
    <arg name="publish_debug"    default="true" />

    <node pkg="mission_control" type="aruco_node.py" name="aruco_node" output="screen">
        <param name="image_topic"       value="$(arg image_topic)" />
        <param name="dictionary"        value="$(arg dictionary)" />
        <param name="valid_ids"         value="$(arg valid_ids)" />
        <param name="invert"            value="$(arg invert)" />
        <param name="marker_length"     value="$(arg marker_length)" />
        <param name="camera_info_topic" value="$(arg camera_info_topic)" />
        <param name="publish_debug"     value="$(arg publish_debug)" />
    </node>
</launch>
